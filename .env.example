# ==========================================
# CẤU HÌNH API ENDPOINT CHO GREENSLOT MOBILE
# ==========================================

# 1. Kết nối Backend Deploy trên Render (MẶC ĐỊNH - Khuyên dùng khi test Mobile trên điện thoại thật/Expo Go):
# Không cần chung mạng WiFi, mở app lên là chạy ngay:
EXPO_PUBLIC_API_URL=https://greenslot-backend.onrender.com/api

# 2. Kết nối Backend chạy Local trên máy tính (Khi dùng điện thoại thật kết nối cùng mạng WiFi):
# Chạy lệnh 'ipconfig' trên Windows (hoặc 'ifconfig' trên Mac) để lấy địa chỉ IPv4 của máy tính (vd: 192.168.1.15):
# EXPO_PUBLIC_API_URL=http://192.168.1.15:8080/api

# 3. Kết nối Backend chạy Local khi dùng Máy ảo Android Emulator (Android Studio):
# Máy ảo Android sử dụng IP 10.0.2.2 để trỏ về localhost của máy tính:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# 4. Kết nối Backend chạy Local khi dùng Máy ảo iOS Simulator (Mac Xcode):
# EXPO_PUBLIC_API_URL=http://localhost:8080/api
