{
  "expo": {
    "name": "GreenSlot",
    "slug": "thongcao123",
    "scheme": "greenslot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/green.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/green.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenslot.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/green.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.greenslot.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://10.10.10.254:8080/api",
      "eas": {
        "projectId": "19bdf3aa-9d82-4d82-8a2f-26f9be0c8b08"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-sharing"
    ]
  }
}
