{
  "expo": {
    "name": "GreenSlot",
    "slug": "greenslot-mobile",
    "scheme": "greenslot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenslot.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#16a34a"
      },
      "package": "com.greenslot.mobile",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "networkSecurityConfig": {
        "domainSettings": [
          {
            "domains": ["greenslot-backend.onrender.com", "greenslot-backend-test.onrender.com"],
            "includeSubdomains": true,
            "allowCleartext": false
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://greenslot-backend.onrender.com/api",
      "eas": {
        "projectId": "06829a8c-f0a0-4ab5-9bba-0a32f4fbd2f0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
